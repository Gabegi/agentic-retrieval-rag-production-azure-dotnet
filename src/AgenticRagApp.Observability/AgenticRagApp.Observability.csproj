         project touches directly (BlobContainerClient) arrives transitively via Infrastructure's
         PackageReferences; this is the one client Infrastructure doesn't already carry. -->
    <PackageReference Include="Azure.Communication.Email" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AgenticRagApp.Infrastructure\AgenticRagApp.Infrastructure.csproj" />
    <ProjectReference Include="..\AgenticRagApp.Common\AgenticRagApp.Common.csproj" />
  </ItemGroup>
</Project>
